// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  cars      Car[]    // خودروهایی که کاربر برای اجاره ثبت کرده
  reservationsAsRenter Reservation[] @relation("RenterReservations")
}

model Car {
  id           String   @id
  name         String
  model        String
  img          String
  location     String
  reviewCount  Int      @default(0) @map("review_count")
  ratingNumber Float    @default(0) @map("rating_number")
  withDriver   String   @map("with_driver")
  rental       Json
  capacity     Json
  features     Json
  engine       Json
  driverRental Json     @map("driver_rental")
  ownerId      String?  @map("owner_id") // null = خودروی پلتفرم، مقدار = مالک (مارکت‌پلیس)
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

model Reservation {
  id        String   @id @default(uuid())
  carId     String   @map("car_id")
  carName   String   @map("car_name")
  name      String
  phone     String
  email     String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  renterId  String?  @map("renter_id") // کاربری که رنت کرده (مارکت‌پلیس)
  renter    User?    @relation("RenterReservations", fields: [renterId], references: [id], onDelete: SetNull)
}
